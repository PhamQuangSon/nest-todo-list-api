# Exact origins only, comma separated. A wildcard is rejected at boot because
# browsers refuse Access-Control-Allow-Origin: * on credentialed requests.
CORS_ORIGINS=http://localhost:5173
PORT=3000

# Phase 1
DATABASE_URL=postgresql://todo:todo@localhost:5432/todo?schema=public&connection_limit=10&pool_timeout=10&connect_timeout=5
REDIS_URL=redis://localhost:6379
