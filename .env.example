# Exact origins only, comma separated. A wildcard is rejected at boot because
# browsers refuse Access-Control-Allow-Origin: * on credentialed requests.
CORS_ORIGINS=http://localhost:5173
PORT=3000

# Phase 1 — Postgres port is 5433 (offset to avoid conflict with local install)
DATABASE_URL=postgresql://todo:todo@localhost:5433/todo?schema=public&connection_limit=10&pool_timeout=10&connect_timeout=5
REDIS_URL=redis://localhost:6382

# At least 32 chars. Generate with: openssl rand -hex 32
JWT_SECRET=change-me-min-32-chars-xxxxxxxxxxxxxxxx

# Phase 3 — reverse proxies in front of the app. 0 when clients connect
# directly (local `node dist/main`); docker-compose sets 1 for nginx. Too high
# lets clients choose their own IP via X-Forwarded-For.
TRUST_PROXY_HOPS=0
# Multiplies every rate limit. Keep at 1; raise only for load tests.
THROTTLE_SCALE=1
